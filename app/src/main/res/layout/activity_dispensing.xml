<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050914">

    <!-- Top Bar -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:src="@android:drawable/ic_menu_crop"
        app:tint="#E8FF00"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="SmartShake"
        android:textColor="#E8FF00"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/logoImage"
        app:layout_constraintStart_toEndOf="@+id/logoImage"
        app:layout_constraintTop_toTopOf="@+id/logoImage" />

    <!-- Station ID (Top Right) -->
    <TextView
        android:id="@+id/tvStationIdLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STATION ID"
        android:textColor="#888888"
        android:textSize="10sp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
        
    <TextView
        android:id="@+id/tvStationIdValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LAB-042"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvStationIdLabel"
        app:layout_constraintEnd_toEndOf="@id/tvStationIdLabel" />

    <!-- Rotating left text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KINETIC PRECISION DISPENSING V2.4"
        android:textColor="#444444"
        android:layout_marginStart="-120dp"
        android:rotation="-90"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Liquid Cup visual -->
    <com.example.smartshake.ui.views.GlowCupView
        android:id="@+id/glowCupView"
        android:layout_width="280dp"
        android:layout_height="350dp"
        android:layout_marginTop="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <!-- Dispensing Title -->
    <TextView
        android:id="@+id/tvDispensingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DISPENSING"
        android:textColor="#FFFFFF"
        android:textSize="56sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/glowCupView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
        
    <!-- Dispensing Subtitle -->
    <TextView
        android:id="@+id/tvDispensingDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OPTIMIZING NUTRIENT RATIO..."
        android:textColor="#BBBBBB"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvDispensingStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
