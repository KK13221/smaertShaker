<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_50sdp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="@dimen/_6sdp">

    <!-- Flavour image -->
    <ImageView
        android:id="@+id/iv_flavour_image"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_chocolate" />

    <!-- Flavour name -->
    <TextView
        android:id="@+id/tv_flavour_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/_8sdp"
        android:text="Chocolate"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_9sdp"
        android:fontFamily="@font/poppins_semibold" />

    <!-- Scoop stepper display (static, matches design) -->
    <TextView
        android:id="@+id/tv_flavour_scoops"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="−  1  +"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_9sdp"
        android:fontFamily="@font/poppins_semibold"
        android:background="@drawable/base_card_bg"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_8sdp" />

    <!-- Price -->
    <TextView
        android:id="@+id/tv_flavour_price"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="wrap_content"
        android:text="₹ 99"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_9sdp"
        android:fontFamily="@font/poppins_semibold"
        android:layout_marginEnd="@dimen/_8sdp" />

    <!-- Remove icon -->
    <ImageView
        android:id="@+id/iv_remove_flavour"
        android:layout_width="@dimen/_16sdp"
        android:layout_height="@dimen/_16sdp"
        android:src="@android:drawable/ic_delete"
        android:tint="#AAAAAA" />

</LinearLayout>