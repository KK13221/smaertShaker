<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:paddingBottom="16dp">

    <!-- Logo (Top Right) -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:src="@drawable/img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title and Subtitle (Centered) -->
    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Payment"
            android:textColor="@color/colorLimeGreen"
            android:textSize="@dimen/_24sdp" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Review your order and proceed to payment"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_10sdp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="52dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_header">

        <!-- Column 1: Flavours & Base -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Flavours"
                    android:textColor="@color/colorLimeGreen"
                    android:textSize="@dimen/_8sdp"
                    android:layout_marginBottom="12dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1AFFFFFF" />

                <!-- RecyclerView for Flavours -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_flavour_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_payment_flavour" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Base"
                    android:textColor="@color/colorLimeGreen"
                    android:textSize="@dimen/_8sdp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1AFFFFFF" />

                <include layout="@layout/item_payment_base_custom" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Column 2: Nutritional Information -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Nutritional Information"
                    android:textColor="@color/colorLimeGreen"
                    android:textSize="@dimen/_8sdp"
                    android:layout_marginBottom="16dp" />

                <include layout="@layout/partial_nutritional_info" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Column 3: Scan & Pay / Order Summary -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Scan &amp; Pay"
                    android:textColor="@color/colorLimeGreen"
                    android:textSize="@dimen/_8sdp"
                    android:layout_marginBottom="16dp" />

                <FrameLayout
                    android:layout_width="@dimen/_52sdp"
                    android:layout_height="@dimen/_52sdp">

                    <ImageView
                        android:id="@+id/iv_qr_code"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/image"
                        android:background="@android:color/white"
                        android:padding="8dp" />

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottie_loading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:lottie_fileName="loading.lottie"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="16dp" android:src="@drawable/img" android:layout_marginEnd="4dp" android:background="#FFFFFF" android:padding="1dp" />
                    <ImageView android:layout_width="24dp" android:layout_height="16dp" android:src="@drawable/img" android:layout_marginEnd="4dp" android:background="#FFFFFF" android:padding="1dp" />
                    <ImageView android:layout_width="24dp" android:layout_height="16dp" android:src="@drawable/img" android:layout_marginEnd="4dp" android:background="#FFFFFF" android:padding="1dp" />
                    <ImageView android:layout_width="24dp" android:layout_height="16dp" android:src="@drawable/img" android:background="#FFFFFF" android:padding="1dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#333333"
                    android:layout_marginVertical="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Order Summary"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_6sdp"
                    android:layout_marginBottom="@dimen/_6sdp" />

                <include layout="@layout/partial_order_summary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Bottom Bar -->
    <!-- Bottom Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="52dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_20sdp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:textAllCaps="false"
            app:cornerRadius="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_continue"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/colorLimeGreen"
            app:strokeWidth="2dp"
            android:backgroundTint="@android:color/transparent" />

        <!-- THIS BUTTON WAS MISSING — add it -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_20sdp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Dispense"
            android:textColor="#000000"
            android:textSize="@dimen/_6sdp"
            android:textAllCaps="false"
            app:cornerRadius="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:backgroundTint="@color/colorLimeGreen" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>